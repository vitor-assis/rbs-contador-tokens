# Copie para .env e preencha só o que for usar. Nenhuma chave é obrigatória:
# sem chave, o app usa tokenizadores locais abertos ou a heurística ("estimado").

# Hugging Face (opcional): só necessário para repositórios "gated" ou para
# aumentar o limite de downloads. Os tokenizadores do models.json são públicos.
HF_TOKEN=

# Contagem exata via API (só é chamada quando você clica em "Contar via API")
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
